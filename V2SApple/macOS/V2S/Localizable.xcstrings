    "Before using network features or purchasing Premium, review how V2S handles your information.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before using network features or purchasing Premium, review how V2S handles your information."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از استفاده از ویژگی‌های شبکه یا خرید Premium، نحوه مدیریت V2S اطلاعات شما را بررسی کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل استخدام ميزات الشبكة أو شراء Premium، راجع كيفية تعامل V2S مع معلوماتك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用网络功能或购买高级版之前，请查看 V2S 如何处理您的信息。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем использовать сетевые функции или приобретать Премиум, проверьте, как V2S обрабатывает вашу информацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de utilizar las funciones de red o comprar Premium, revise cómo V2S maneja su información."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de usar os recursos de rede ou adquirir o Premium, revise como V2S lida com suas informações."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'utiliser les fonctionnalités réseau ou d'acheter Premium, vérifiez comment V2S gère vos informations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor Sie Netzwerkfunktionen nutzen oder Premium kaufen, prüfen Sie, wie V2S mit Ihren Daten umgeht."
          }
        }
      }
    },
