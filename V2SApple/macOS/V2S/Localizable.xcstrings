    "Test purchase environment — real offer codes require the Mac App Store version. Purchases and Restore in this copy use test entitlements.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test purchase environment — real offer codes require the Mac App Store version. Purchases and Restore in this copy use test entitlements."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "محیط آزمایشی خرید — کدهای واقعی به نسخه Mac App Store نیاز دارند. خرید و بازیابی در این نسخه آزمایشی است."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيئة الشراء التجريبية — تتطلب رموز العرض الحقيقية إصدار Mac App Store. تستخدم عمليات الشراء والاستعادة في هذه النسخة استحقاقات الاختبار."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试购买环境——真实优惠代码需要Mac App Store版本。此副本中的购买和恢复使用测试权利。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовая среда покупки — для реальных кодов предложений требуется версия Mac App Store. Для покупок и восстановления в этой копии используются тестовые права."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entorno de compra de prueba: los códigos de oferta reales requieren la versión Mac App Store. Las compras y la restauración en esta copia utilizan derechos de prueba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambiente de compra de teste – códigos de oferta reais exigem a versão Mac App Store. Compras e Restauração nesta cópia usam direitos de teste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environnement de test : les codes réels nécessitent la version Mac App Store. Les achats et restaurations de cette copie utilisent des droits de test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Testkaufumgebung – echte Angebotscodes erfordern die Version Mac App Store. Käufe und Wiederherstellungen in dieser Kopie nutzen Testberechtigungen."
          }
        }
      }
