    "Imported profiles and subscription credentials are stored in macOS Keychain. Activity messages redact proxy links and URLs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported profiles and subscription credentials are stored in macOS Keychain. Activity messages redact proxy links and URLs."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مشخصات سرورهای واردشده و اطلاعات ورود اشتراک در Keychain مک ذخیره می‌شوند. لینک‌های پروکسی و نشانی‌های وب از گزارش فعالیت حذف می‌شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تخزين ملفات التعريف وبيانات اعتماد الاشتراك المستوردة في macOS Keychain. تقوم رسائل النشاط بتنقيح روابط الوكيل وعناوين URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的配置文件和订阅凭据存储在 macOS Keychain 中。活动消息编辑代理链接和 URL。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортированные профили и учетные данные подписки хранятся в macOS Keychain. Сообщения об активности редактируют прокси-ссылки и URL-адреса."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles importados y las credenciales de suscripción se almacenan en macOS Keychain. Los mensajes de actividad redactan enlaces proxy y URL."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis importados e credenciais de assinatura são armazenados em macOS Keychain. As mensagens de atividade editam links e URLs de proxy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils importés et les informations d'identification d'abonnement sont stockés dans macOS Keychain. Les messages d'activité rédigent les liens proxy et les URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Profile und Abonnementanmeldeinformationen werden in macOS Keychain gespeichert. Aktivitätsnachrichten schwärzen Proxy-Links und URLs."
          }
        }
      }
    },
    "In System Settings, go to General › Sharing and open Internet Sharing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings, go to General › Sharing and open Internet Sharing."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در تنظیمات سیستم، به General › Sharing بروید و Internet Sharing را باز کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في إعدادات النظام، انتقل إلى عام ›المشاركة وافتح مشاركة الإنترنت."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中，转至常规 › 共享并打开 Internet 共享。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настройках системы перейдите в раздел «Основные» › «Общий доступ» и откройте «Общий доступ в Интернет»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Configuración del sistema, vaya a General › Compartir y abra Compartir Internet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nas Configurações do Sistema, vá para Geral › Compartilhamento e abra Compartilhamento de Internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Paramètres système, accédez à Général > Partage et ouvrez le partage Internet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen Sie in den Systemeinstellungen zu „Allgemein“ > „Freigabe“ und öffnen Sie „Internetfreigabe“."
          }
        }
      }
    },
