    "System DNS uses macOS-configured resolvers. DNS requests may not use a V2S resolver.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System DNS uses macOS-configured resolvers. DNS requests may not use a V2S resolver."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سیستم DNS از حل کننده های پیکربندی شده macOS استفاده می کند. درخواست های DNS ممکن است از حل کننده V2S استفاده نکنند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم النظام DNS وحدات الحل التي تم تكوينها بواسطة macOS. لا يجوز لطلبات DNS استخدام محلل V2S."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统 DNS 使用 macOS 配置的解析器。 DNS 请求不能使用 V2S 解析器。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система DNS использует преобразователи, настроенные macOS. Запросы DNS не могут использовать преобразователь V2S."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema DNS utiliza resolutores configurados con macOS. Las solicitudes DNS no pueden utilizar un solucionador V2S."
