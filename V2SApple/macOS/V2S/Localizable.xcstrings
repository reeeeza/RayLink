    "%@ public server(s) passed a proxy check from %@ sources on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ public server(s) passed a proxy check from %@ sources on this Mac."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور(های) عمومی %1$@ یک بررسی پروکسی را از منابع %2$@ در این Mac ارسال کردند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجتاز خادم (خوادم) %1$@ العام فحص الوكيل من مصادر %2$@ على جهاز Mac هذا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 公共服务器通过了来自此 Mac 上 %2$@ 源的代理检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публичные серверы %1$@ прошли проверку прокси-сервера из источников %2$@ на этом Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores públicos %1$@ pasaron una verificación de proxy de fuentes %2$@ en esta Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores públicos %1$@ passaram em uma verificação de proxy de fontes %2$@ neste Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs publics %1$@ ont réussi une vérification de proxy à partir des sources %2$@ sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ öffentliche Server haben eine Proxy-Prüfung von %2$@-Quellen auf diesem Mac bestanden."
          }
        }
      }
    },
