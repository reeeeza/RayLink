    "Apple shows a subscription, but V2S could not verify server access. Try Restore Purchases to retry verification.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple shows a subscription, but V2S could not verify server access. Try Restore Purchases to retry verification."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple اشتراکی را نشان می دهد، اما V2S نتوانست دسترسی سرور را تأیید کند. برای تأیید مجدد، بازیابی خریدها را امتحان کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض Apple اشتراكًا، ولكن V2S لم يتمكن من التحقق من الوصول إلى الخادم. حاول استعادة المشتريات لإعادة محاولة التحقق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 显示订阅，但 V2S 无法验证服务器访问。尝试恢复购买以重试验证。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple показывает подписку, но V2S не смог проверить доступ к серверу. Попробуйте восстановить покупки, чтобы повторить проверку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple muestra una suscripción, pero V2S no pudo verificar el acceso al servidor. Intente Restaurar compras para volver a intentar la verificación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple mostra uma assinatura, mas V2S não conseguiu verificar o acesso ao servidor. Experimente Restaurar compras para tentar novamente a verificação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple affiche un abonnement, mais V2S n'a pas pu vérifier l'accès au serveur. Essayez de restaurer les achats pour réessayer la vérification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple zeigt ein Abonnement an, aber V2S konnte den Serverzugriff nicht überprüfen. Versuchen Sie „Käufe wiederherstellen“, um die Überprüfung erneut zu versuchen."
