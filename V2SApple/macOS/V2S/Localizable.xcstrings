    "A proxy response check measures a request through a server. It does not verify the VPN tunnel, server location, or overall privacy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A proxy response check measures a request through a server. It does not verify the VPN tunnel, server location, or overall privacy."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی پاسخ پروکسی درخواست را از طریق سرور اندازه گیری می کند. تونل VPN، مکان سرور یا حریم خصوصی کلی را تأیید نمی کند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم فحص استجابة الوكيل بقياس الطلب من خلال الخادم. ولا يتحقق من نفق VPN أو موقع الخادم أو الخصوصية العامة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理响应检查通过服务器测量请求。它不验证 VPN 隧道、服务器位置或整体隐私。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка ответа прокси-сервера измеряет запрос через сервер. Он не проверяет VPN-туннель, местоположение сервера или общую конфиденциальность."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una verificación de respuesta de proxy mide una solicitud a través de un servidor. No verifica el túnel VPN, la ubicación del servidor ni la privacidad general."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação de resposta do proxy mede uma solicitação por meio de um servidor. Ele não verifica o túnel VPN, a localização do servidor ou a privacidade geral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vérification de réponse proxy mesure une demande via un serveur. Il ne vérifie pas le tunnel VPN, l'emplacement du serveur ou la confidentialité globale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Proxy-Antwortprüfung misst eine Anfrage über einen Server. Der VPN-Tunnel, der Serverstandort oder die allgemeine Privatsphäre werden nicht überprüft."
          }
        }
      }
    },
    "A wired, USB, or Thunderbolt upstream connection is preferable because Wi-Fi is used to broadcast the hotspot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wired, USB, or Thunderbolt upstream connection is preferable because Wi-Fi is used to broadcast the hotspot."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال سیمی، USB، یا Thunderbolt بالادست ترجیح داده می شود زیرا Wi-Fi برای پخش نقطه اتصال استفاده می شود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفضل الاتصال السلكي، USB، أو Thunderbolt لأنه يتم استخدام Wi-Fi لبث نقطة الاتصال."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有线、USB 或 Thunderbolt 上游连接是首选，因为 Wi-Fi 用于广播热点。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочтительно использовать проводное соединение USB или Thunderbolt, поскольку Wi-Fi используется для широковещательной рассылки точки доступа."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es preferible una conexión ascendente por cable, USB o Thunderbolt porque Wi-Fi se utiliza para transmitir el punto de acceso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conexão upstream com fio, USB ou Thunderbolt é preferível porque Wi-Fi é usada para transmitir o ponto de acesso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une connexion filaire, USB ou Thunderbolt en amont est préférable car Wi-Fi est utilisée pour diffuser le point d'accès."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kabelgebundene, USB- oder Thunderbolt-Upstream-Verbindung ist vorzuziehen, da Wi-Fi zur Übertragung des Hotspots verwendet wird."
          }
        }
      }
    },
