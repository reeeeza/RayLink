          "stringUnit": {
            "state": "translated",
            "value": "انقر للتبديل هنا عند الاتصال. بخلاف ذلك، انقر لتحديد أو اضغط مع الاستمرار للاتصال."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后点击此处切换。否则，单击以选择或按住以连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы переключиться здесь при подключении. В противном случае нажмите, чтобы выбрать, или нажмите и удерживайте, чтобы подключиться."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic para cambiar aquí cuando esté conectado. De lo contrario, haga clic para seleccionar o mantenga presionado para conectarse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para mudar aqui quando conectado. Caso contrário, clique para selecionar ou pressione e segure para conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour basculer ici une fois connecté. Sinon, cliquez pour sélectionner ou appuyez et maintenez pour vous connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie, um hierher zu wechseln, wenn eine Verbindung besteht. Andernfalls klicken Sie zum Auswählen oder halten Sie gedrückt, um eine Verbindung herzustellen."
          }
        }
      }
    },
    "Click to switch here when connected. Press and hold to connect otherwise.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to switch here when connected. Press and hold to connect otherwise."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای جابجایی در هنگام اتصال اینجا کلیک کنید. برای اتصال در غیر این صورت فشار دهید و نگه دارید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر للتبديل هنا عند الاتصال. اضغط مع الاستمرار للاتصال بخلاف ذلك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后点击此处切换。否则按住即可连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы переключиться здесь при подключении. Нажмите и удерживайте, чтобы подключиться в противном случае."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic para cambiar aquí cuando esté conectado. Mantenga presionado para conectarse de otra manera."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para mudar aqui quando conectado. Pressione e segure para conectar de outra forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour basculer ici une fois connecté. Appuyez et maintenez pour vous connecter autrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie, um hierher zu wechseln, wenn eine Verbindung besteht. Andernfalls drücken und halten, um eine Verbindung herzustellen."
          }
        }
      }
    },
