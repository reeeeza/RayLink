    "Mux may help some servers and reduce compatibility with others. Reconnect after changing it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux may help some servers and reduce compatibility with others. Reconnect after changing it."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux ممکن است به برخی از سرورها کمک کند و سازگاری با برخی دیگر را کاهش دهد. پس از تغییر مجدد آن را وصل کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux قد يساعد بعض الخوادم ويقلل التوافق مع الآخرين. أعد الاتصال بعد تغييره."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux 可能会帮助某些服务器并降低与其他服务器的兼容性。更改后重新连接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux может помочь некоторым серверам и снизить совместимость с другими. Повторно подключитесь после изменения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux puede ayudar a algunos servidores y reducir la compatibilidad con otros. Vuelva a conectarlo después de cambiarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux pode ajudar alguns servidores e reduzir a compatibilidade com outros. Reconecte depois de alterá-lo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux peut aider certains serveurs et réduire la compatibilité avec d'autres. Reconnectez-vous après l'avoir modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mux kann einigen Servern helfen und die Kompatibilität mit anderen verringern. Stellen Sie die Verbindung wieder her, nachdem Sie es geändert haben."
          }
        }
      }
    },
