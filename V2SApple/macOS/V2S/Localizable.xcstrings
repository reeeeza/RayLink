    "Apple's redemption service could not be reached. Check your connection. If you already redeemed the code, use Restore Purchases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple's redemption service could not be reached. Check your connection. If you already redeemed the code, use Restore Purchases."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به سرویس بازخرید Apple امکان پذیر نیست. اتصال خود را بررسی کنید. اگر قبلاً کد را بازخرید کرده اید، از Restore Purchases استفاده کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى خدمة الاسترداد الخاصة بـ Apple. تحقق من اتصالك. إذا قمت بالفعل باسترداد الرمز، فاستخدم \"استعادة المشتريات\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 的兑换服务无法访问。检查您的连接。如果您已经兑换了代码，请使用“恢复购买”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось связаться со службой погашения Apple. Проверьте свое соединение. Если вы уже активировали код, используйте «Восстановить покупки»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con el servicio de canje de Apple. Comprueba tu conexión. Si ya canjeaste el código, usa Restaurar compras."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de resgate de Apple não pôde ser alcançado. Verifique sua conexão. Se você já resgatou o código, use Restaurar compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de remboursement de Apple n'a pas pu être atteint. Vérifiez votre connexion. Si vous avez déjà utilisé le code, utilisez Restaurer les achats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einlösedienst von Apple konnte nicht erreicht werden. Überprüfen Sie Ihre Verbindung. Wenn Sie den Code bereits eingelöst haben, verwenden Sie „Einkäufe wiederherstellen“."
          }
        }
      }
    },
