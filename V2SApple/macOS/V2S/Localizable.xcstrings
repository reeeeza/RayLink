    "Subscription URLs are private account information and are kept out of activity logs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription URLs are private account information and are kept out of activity logs."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آدرس‌های اینترنتی اشتراک اطلاعات حساب خصوصی هستند و از گزارش‌های فعالیت دور نگه داشته می‌شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عناوين URL الخاصة بالاشتراك هي معلومات خاصة بالحساب ويتم الاحتفاظ بها خارج سجلات الأنشطة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅 URL 是私人帐户信息，不会出现在活动日志中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-адреса подписки представляют собой личную информацию учетной записи и не попадают в журналы активности."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las URL de suscripción son información de cuenta privada y se mantienen fuera de los registros de actividad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "URLs de assinatura são informações privadas da conta e são mantidas fora dos registros de atividades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les URL d'abonnement sont des informations de compte privées et sont conservées en dehors des journaux d'activité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnement-URLs sind private Kontoinformationen und werden nicht in Aktivitätsprotokollen erfasst."
          }
        }
      }
    },
    "Subscription links must use HTTPS and must not contain credentials in the URL.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription links must use HTTPS and must not contain credentials in the URL."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوندهای اشتراک باید از HTTPS استفاده کنند و نباید دارای اعتبارنامه در URL باشند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تستخدم روابط الاشتراك HTTPS ويجب ألا تحتوي على بيانات اعتماد في عنوان URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅链接必须使用 HTTPS 并且 URL 中不得包含凭据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки на подписку должны использовать HTTPS и не должны содержать учетные данные в URL-адресе."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de suscripción deben usar HTTPS y no deben contener credenciales en la URL."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links de assinatura devem usar HTTPS e não devem conter credenciais na URL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens d'abonnement doivent utiliser HTTPS et ne doivent pas contenir d'informations d'identification dans l'URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementlinks müssen HTTPS verwenden und dürfen keine Anmeldeinformationen in der URL enthalten."
          }
        }
      }
    },
    "Subscription plans are unavailable right now. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription plans are unavailable right now. Please try again later."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "طرح‌های اشتراک اکنون در دسترس نیستند. بعداً دوباره تلاش کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطط الاشتراك غير متوفرة في الوقت الحالي. يرجى المحاولة مرة أخرى لاحقا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅计划目前不可用。请稍后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планы подписки сейчас недоступны. Пожалуйста, повторите попытку позже."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
