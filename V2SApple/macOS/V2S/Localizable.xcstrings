    "Some local configuration could not be removed. Reopen V2S and retry; do not uninstall until cleanup succeeds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some local configuration could not be removed. Reopen V2S and retry; do not uninstall until cleanup succeeds."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی از تنظیمات محلی حذف نشد. V2S را دوباره باز کنید و دوباره امتحان کنید. تا زمانی که پاکسازی با موفقیت انجام نشد، آن را حذف نصب نکنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إزالة بعض التكوينات المحلية. أعد فتح V2S وأعد المحاولة؛ لا تقم بإلغاء التثبيت حتى تنجح عملية التنظيف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法删除某些本地配置。重新打开V2S并重试；在清理成功之前请勿卸载。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось удалить некоторые локальные конфигурации. Снова откройте V2S и повторите попытку; не удаляйте, пока очистка не завершится успешно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar alguna configuración local. Vuelva a abrir V2S y vuelva a intentarlo; no lo desinstale hasta que la limpieza se realice correctamente."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas configurações locais não puderam ser removidas. Abra novamente V2S e tente novamente; não desinstale até que a limpeza seja bem-sucedida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines configurations locales n'ont pas pu être supprimées. Rouvrez V2S et réessayez ; ne désinstallez pas tant que le nettoyage n'a pas réussi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige lokale Konfigurationen konnten nicht entfernt werden. Öffnen Sie V2S erneut und versuchen Sie es erneut. Nicht deinstallieren, bis die Bereinigung erfolgreich ist."
          }
        }
      }
    },
