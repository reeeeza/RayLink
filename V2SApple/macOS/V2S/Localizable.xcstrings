    "An active Apple subscription and V2S server verification are required to connect to this premium server.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An active Apple subscription and V2S server verification are required to connect to this premium server."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک Apple فعال و تأیید سرور V2S برای اتصال به این سرور ممتاز مورد نیاز است."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم وجود اشتراك نشط في Apple والتحقق من خادم V2S للاتصال بهذا الخادم المتميز."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到此高级服务器需要有效的 Apple 订阅和 V2S 服务器验证。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для подключения к этому премиум-серверу необходимы активная подписка Apple и проверка сервера V2S."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una suscripción activa Apple y una verificación del servidor V2S para conectarse a este servidor premium."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura Apple ativa e uma verificação de servidor V2S são necessárias para conectar-se a este servidor premium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement Apple actif et une vérification du serveur V2S sont requis pour se connecter à ce serveur premium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Verbindung zu diesem Premium-Server sind ein aktives Apple-Abonnement und eine V2S-Serververifizierung erforderlich."
          }
        }
      }
    },
