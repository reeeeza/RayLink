    "Paste a replacement link for this manually added server. The current link stays saved until the new one is valid.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a replacement link for this manually added server. The current link stays saved until the new one is valid."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک پیوند جایگزین برای این سرور اضافه شده دستی جایگذاری کنید. پیوند فعلی تا زمانی که پیوند جدید معتبر باشد ذخیره می شود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رابطًا بديلاً لهذا الخادم المُضاف يدويًا. ويظل الرابط الحالي محفوظًا حتى يصبح الرابط الجديد صالحًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴此手动添加的服务器的替换链接。当前链接将保持保存状态，直至新链接有效。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте заменяющую ссылку для этого добавленного вручную сервера. Текущая ссылка сохраняется до тех пор, пока новая не станет действительной."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue un enlace de reemplazo para este servidor agregado manualmente. El enlace actual permanece guardado hasta que el nuevo sea válido."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um link de substituição para este servidor adicionado manualmente. O link atual permanece salvo até que o novo seja válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien de remplacement pour ce serveur ajouté manuellement. Le lien actuel reste enregistré jusqu'à ce que le nouveau soit valide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Ersatzlink für diesen manuell hinzugefügten Server ein. Der aktuelle Link bleibt gespeichert, bis der neue gültig ist."
          }
        }
      }
    },
    "Paste a subscription link or one or more server links. V2S will detect the format.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a subscription link or one or more server links. V2S will detect the format."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوند اشتراک یا یک یا چند پیوند سرور را جایگذاری کنید. V2S قالب را شناسایی می کند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بلصق رابط الاشتراك أو رابط خادم واحد أو أكثر. V2S سوف يكتشف التنسيق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴订阅链接或一个或多个服务器链接。 V2S 将检测格式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте ссылку на подписку или одну или несколько ссылок на сервер. V2S определит формат."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue un enlace de suscripción o uno o más enlaces de servidor. V2S detectará el formato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um link de assinatura ou um ou mais links de servidor. V2S detectará o formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien d'abonnement ou un ou plusieurs liens de serveur. V2S détectera le format."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Abonnementlink oder einen oder mehrere Serverlinks ein. V2S erkennt das Format."
          }
        }
      }
    },
    "Paste a subscription link or server links. V2S detects the format automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a subscription link or server links. V2S detects the format automatically."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوند اشتراک یا پیوندهای سرور را جایگذاری کنید. V2S قالب را به طور خودکار تشخیص می دهد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق رابط الاشتراك أو روابط الخادم. V2S يكتشف التنسيق تلقائيًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴订阅链接或服务器链接。 V2S 自动检测格式。"
          }
        },
        "ru": {
