    "Development installation · purchases use the test environment. Real offer codes require the Mac App Store version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development installation · purchases use the test environment. Real offer codes require the Mac App Store version."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب توسعه · خریدها از محیط تست استفاده می کنند. کدهای پیشنهاد واقعی به نسخه Mac App Store نیاز دارند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تركيب التطوير · المشتريات تستخدم بيئة الاختبار. تتطلب رموز العرض الحقيقية الإصدار Mac App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发安装·购买使用测试环境。真实优惠代码需要 Mac App Store 版本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка разработки · При покупке используется тестовая среда. Для реальных кодов предложений требуется версия Mac App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalación de desarrollo · compras utilizan el entorno de prueba. Los códigos de oferta reales requieren la versión Mac App Store."
          }
        },
        "pt": {
