    "Use WPA2/WPA3 with a strong password. Turn Internet Sharing on in System Settings when you are ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use WPA2/WPA3 with a strong password. Turn Internet Sharing on in System Settings when you are ready."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از WPA2/WPA3 با رمز عبور قوی استفاده کنید. وقتی آماده شدید، اشتراک گذاری اینترنت را در تنظیمات سیستم روشن کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم WPA2/WPA3 بكلمة مرور قوية. قم بتشغيل مشاركة الإنترنت في إعدادات النظام عندما تكون جاهزًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 WPA2/WPA3 和强密码。准备好后，在系统设置中打开互联网共享。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте WPA2/WPA3 с надежным паролем. Когда будете готовы, включите общий доступ к Интернету в настройках системы."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice WPA2/WPA3 con una contraseña segura. Active Compartir Internet en Configuración del sistema cuando esté listo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use WPA2/WPA3 com uma senha forte. Ative o compartilhamento de Internet nas configurações do sistema quando estiver pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez WPA2/WPA3 avec un mot de passe fort. Activez le partage Internet dans les paramètres système lorsque vous êtes prêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie WPA2/WPA3 mit einem sicheren Passwort. Aktivieren Sie die Internetfreigabe in den Systemeinstellungen, wenn Sie bereit sind."
          }
        }
      }
    },
