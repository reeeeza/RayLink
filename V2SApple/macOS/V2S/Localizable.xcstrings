    },
    "V2S could not verify Premium access from this redemption. No new access was granted. Try Restore Purchases to retry verification.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S could not verify Premium access from this redemption. No new access was granted. Try Restore Purchases to retry verification."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S نتوانست دسترسی Premium را از این بازخرید تأیید کند. دسترسی جدیدی داده نشد. برای تأیید مجدد، بازیابی خریدها را امتحان کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن V2S من التحقق من الوصول إلى Premium من هذا الاسترداد. لم يتم منح أي وصول جديد. حاول استعادة المشتريات لإعادة محاولة التحقق."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S 无法验证此次兑换的高级访问权限。没有授予新的访问权限。尝试恢复购买以重试验证。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S не удалось подтвердить доступ к Премиуму в рамках этого использования. Новый доступ не был предоставлен. Попробуйте восстановить покупки, чтобы повторить проверку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S no pudo verificar el acceso Premium desde este canje. No se concedió ningún nuevo acceso. Intente Restaurar compras para volver a intentar la verificación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S não conseguiu verificar o acesso Premium deste resgate. Nenhum novo acesso foi concedido. Experimente Restaurar compras para tentar novamente a verificação."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S n'a pas pu vérifier l'accès Premium à partir de cet échange. Aucun nouvel accès n'a été accordé. Essayez de restaurer les achats pour réessayer la vérification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S konnte den Premium-Zugriff dieser Einlösung nicht bestätigen. Es wurde kein neuer Zugriff gewährt. Versuchen Sie „Käufe wiederherstellen“, um die Überprüfung erneut zu versuchen."
          }
        }
      }
    },
    "V2S did not finish connecting. Check VPN status in System Settings and try again.": {
      "extractionState": "manual",
