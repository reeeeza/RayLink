    "Network features are off until you agree to the privacy disclosure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network features are off until you agree to the privacy disclosure."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمانی که با افشای حریم خصوصی موافقت نکنید، ویژگی‌های شبکه خاموش هستند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إيقاف تشغيل ميزات الشبكة حتى توافق على الكشف عن الخصوصية."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您同意隐私披露之前，网络功能将关闭。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сетевые функции отключены до тех пор, пока вы не согласитесь на раскрытие конфиденциальной информации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones de red están desactivadas hasta que usted acepte la divulgación de privacidad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos de rede ficam desativados até que você concorde com a divulgação de privacidade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités réseau sont désactivées jusqu'à ce que vous acceptiez la divulgation de confidentialité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Netzwerkfunktionen sind deaktiviert, bis Sie der Offenlegung der Privatsphäre zustimmen."
          }
        }
      }
    },
