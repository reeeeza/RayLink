    "Sandbox test access is active until %@. Test renewals are accelerated.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandbox test access is active until %@. Test renewals are accelerated."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی آزمایشی جعبه ایمنی تا %1$@ فعال است. تمدید تست تسریع می شود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى اختبار Sandbox نشط حتى %1$@. يتم تسريع تجديدات الاختبار."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙盒测试访问在 %1$@ 之前一直有效。测试更新速度加快。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тестовый доступ к песочнице активен до %1$@. Продление тестов ускоряется."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la prueba de Sandbox está activo hasta %1$@. Se aceleran las renovaciones de pruebas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso de teste de sandbox está ativo até %1$@. As renovações de testes são aceleradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au test Sandbox est actif jusqu’au %1$@. Les renouvellements de tests sont accélérés."
          }
