    "Measure proxy response time. Ping does not certify a VPN tunnel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure proxy response time. Ping does not certify a VPN tunnel."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان پاسخگویی پروکسی را اندازه گیری کنید. پینگ یک تونل VPN را تأیید نمی کند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قياس وقت استجابة الوكيل. لا يصادق Ping على نفق VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量代理响应时间。 Ping 不验证 VPN 隧道。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерьте время ответа прокси. Ping не сертифицирует VPN-туннель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mida el tiempo de respuesta del proxy. Ping no certifica un túnel VPN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Meça o tempo de resposta do proxy. O Ping não certifica um túnel VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurez le temps de réponse du proxy. Ping ne certifie pas un tunnel VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messen Sie die Antwortzeit des Proxys. Ping zertifiziert keinen VPN-Tunnel."
          }
        }
      }
    },
    "Measures an HTTPS request through the selected proxy; it does not certify the VPN tunnel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures an HTTPS request through the selected proxy; it does not certify the VPN tunnel."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست HTTPS را از طریق پراکسی انتخاب شده اندازه گیری می کند. تونل VPN را تأیید نمی کند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقيس طلب HTTPS من خلال الوكيل المحدد؛ ولا يصدق على نفق VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过所选代理测量 HTTPS 请求；它不验证 VPN 隧道。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измеряет запрос HTTPS через выбранный прокси; он не сертифицирует VPN-туннель."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide una solicitud HTTPS a través del proxy seleccionado; no certifica el túnel VPN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede uma solicitação HTTPS por meio do proxy selecionado; não certifica o túnel VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure une requête HTTPS via le proxy sélectionné ; il ne certifie pas le tunnel VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst eine HTTPS-Anfrage über den ausgewählten Proxy; Der VPN-Tunnel wird nicht zertifiziert."
          }
        }
      }
    },
