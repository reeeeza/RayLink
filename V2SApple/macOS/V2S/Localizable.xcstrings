    "Your server profiles and subscriptions will not be removed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server profiles and subscriptions will not be removed."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پروفایل ها و اشتراک های سرور شما حذف نخواهد شد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تتم إزالة ملفات تعريف الخادم والاشتراكات الخاصة بك."
          }
        },
        "zh-Hans": {
