    "Subscriptions renew automatically until canceled. You can manage or cancel through your Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically until canceled. You can manage or cancel through your Apple Account."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک ها به طور خودکار تمدید می شوند تا زمانی که لغو شوند. می‌توانید از طریق Apple Account خود را مدیریت یا لغو کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تجديد الاشتراكات تلقائيًا حتى يتم إلغاؤها. يمكنك الإدارة أو الإلغاء من خلال Apple Account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅会自动续订，直至取消。您可以通过 Apple Account 进行管理或取消。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписки продлеваются автоматически до тех пор, пока не будут отменены. Вы можете управлять или отменить это действие через свой Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente hasta que se cancelan. Puedes gestionar o cancelar a través de tu Apple Account."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas são renovadas automaticamente até serem canceladas. Você pode gerenciar ou cancelar através do seu Apple Account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement jusqu'à annulation. Vous pouvez gérer ou annuler via votre Apple Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements verlängern sich automatisch, bis sie gekündigt werden. Sie können über Ihr Apple Account verwalten oder kündigen."
          }
        }
      }
    },
