        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "License notices could not be loaded. Please use the contact form at https://v2teh.com/contact.html."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعلامیه های مجوز بارگیری نشدند. لطفاً از فرم تماس در https://v2teh.com/contact.html. استفاده کنید"
