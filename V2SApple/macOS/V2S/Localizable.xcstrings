    "Optional macOS traffic enforcement. Leave off if it prevents this Mac or other network services from connecting.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional macOS traffic enforcement. Leave off if it prevents this Mac or other network services from connecting."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعمال محدودیت ترافیک در macOS اختیاری است. اگر مانع اتصال این مک یا دیگر سرویس‌های شبکه می‌شود، آن را خاموش نگه دارید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري macOS فرض حركة المرور. اتركه إذا كان يمنع جهاز Mac أو خدمات الشبكة الأخرى من الاتصال."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的 macOS 流量强制执行。如果它阻止此 Mac 或其他网络服务连接，请关闭。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительный контроль трафика macOS. Отключите этот параметр, если это препятствует подключению этого Mac или других сетевых служб."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control de tráfico macOS opcional. Déjelo desactivado si impide que esta Mac u otros servicios de red se conecten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicação de tráfego macOS opcional. Deixe desativado se isso impedir a conexão deste Mac ou de outros serviços de rede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application facultative du trafic macOS. Laissez cette option si cela empêche ce Mac ou d'autres services réseau de se connecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale macOS-Verkehrsdurchsetzung. Lassen Sie es weg, wenn dadurch die Verbindung zwischen diesem Mac oder anderen Netzwerkdiensten verhindert wird."
          }
        }
      }
    },
