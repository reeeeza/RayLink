          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta assinatura Apple não está ativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet abonnement Apple n'est pas actif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
