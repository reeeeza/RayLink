    "DNS and routing changes take effect after reconnecting. Local-network bypass sends local traffic outside the VPN.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS and routing changes take effect after reconnecting. Local-network bypass sends local traffic outside the VPN."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS و تغییرات مسیریابی پس از اتصال مجدد اعمال می شود. دور زدن شبکه محلی ترافیک محلی را به خارج از VPN ارسال می کند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS وتسري تغييرات التوجيه بعد إعادة الاتصال. يرسل تجاوز الشبكة المحلية حركة المرور المحلية خارج VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 和路由更改在重新连接后生效。本地网络旁路将本地流量发送到 VPN 外部。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS и изменения маршрутизации вступают в силу после повторного подключения. Обход локальной сети отправляет локальный трафик за пределы VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS y los cambios de ruta entran en vigor después de volver a conectarse. La omisión de la red local envía el tráfico local fuera de la VPN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS e as alterações de roteamento entram em vigor após a reconexão. O bypass de rede local envia tráfego local para fora da VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS et les modifications de routage prennent effet après la reconnexion. Le contournement du réseau local envoie le trafic local en dehors du VPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS und Routing-Änderungen werden nach erneuter Verbindung wirksam. Durch die Umgehung des lokalen Netzwerks wird lokaler Datenverkehr außerhalb des VPN weitergeleitet."
          }
        }
      }
    },
