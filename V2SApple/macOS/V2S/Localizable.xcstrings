          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Туннель V2S остановлен до подключения: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El túnel V2S se detuvo antes de conectarse: %1$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O túnel V2S parou antes de ser conectado: %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tunnel V2S s'est arrêté avant de se connecter : %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der V2S-Tunnel wurde gestoppt, bevor er eine Verbindung herstellte: %1$@"
          }
        }
      }
    },
    "The public server list is expired or has an unsupported format.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The public server list is expired or has an unsupported format."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لیست سرور عمومی منقضی شده است یا دارای قالب پشتیبانی نشده است."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة الخادم العامة منتهية الصلاحية أو ذات تنسيق غير مدعوم."
          }
        },
        "zh-Hans": {
          "stringUnit": {
