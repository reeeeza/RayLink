          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de servidores públicos expirou ou tem um formato não suportado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des serveurs publics a expiré ou son format n'est pas pris en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die öffentliche Serverliste ist abgelaufen oder hat ein nicht unterstütztes Format."
          }
        }
      }
    },
    "The purchase is awaiting approval. V2S will check again when Apple confirms it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is awaiting approval. V2S will check again when Apple confirms it."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خرید در انتظار تایید است. وقتی Apple آن را تأیید کرد، V2S دوباره بررسی می کند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشراء في انتظار الموافقة. سوف يقوم V2S بالتحقق مرة أخرى عندما يؤكد Apple ذلك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次购买正在等待批准。当 Apple 确认后，V2S 会再次检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка ожидает одобрения. V2S проверит еще раз, когда Apple подтвердит это."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra está pendiente de aprobación. V2S volverá a comprobarlo cuando Apple lo confirme."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra está aguardando aprovação. V2S verificará novamente quando Apple confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat est en attente d'approbation. V2S vérifiera à nouveau lorsque Apple le confirmera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf muss noch genehmigt werden. V2S wird erneut prüfen, wenn Apple dies bestätigt."
          }
        }
      }
    },
    "The replacement server link could not be read or saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The replacement server link could not be read or saved."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوند سرور جایگزین خوانده یا ذخیره نشد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة رابط الخادم البديل أو حفظه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取或保存替换服务器链接。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылку на заменяющий сервер не удалось прочитать или сохранить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace del servidor de reemplazo no se pudo leer ni guardar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O link do servidor substituto não pôde ser lido ou salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien du serveur de remplacement n'a pas pu être lu ou enregistré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ersatzserver-Link konnte nicht gelesen oder gespeichert werden."
          }
        }
      }
    },
    "The server could not be updated. Check the link and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not be updated. Check the link and try again."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور به روز نمی شود. پیوند را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحديث الخادم. تحقق من الرابط وحاول مرة أخرى."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无法更新。检查链接并重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не удалось обновить. Проверьте ссылку и повторите попытку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el servidor. Comprueba el enlace y vuelve a intentarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não pôde ser atualizado. Verifique o link e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas pu être mis à jour. Vérifiez le lien et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte nicht aktualisiert werden. Überprüfen Sie den Link und versuchen Sie es erneut."
          }
        }
      }
    },
    "The subscription response is larger than V2S allows.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription response is larger than V2S allows."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ اشتراک بزرگتر از V2S اجازه می دهد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استجابة الاشتراك أكبر مما يسمح به V2S."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅响应大于 V2S 允许的范围。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ на подписку превышает размер V2S."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta de suscripción es mayor de lo que permite V2S."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta da assinatura é maior do que V2S permite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de l'abonnement est plus grande que ce que V2S autorise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abonnementantwort ist größer als V2S zulässt."
          }
        }
      }
    },
    "This Apple subscription is not active.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Apple subscription is not active."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این اشتراک Apple فعال نیست."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الاشتراك Apple غير نشط."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
