    "Selecting another server disconnects the current tunnel and reconnects with the new server. Disconnect before deleting servers.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection d'un autre serveur déconnecte le tunnel actuel et se reconnecte au nouveau serveur. Déconnectez-vous avant de supprimer des serveurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionar otro servidor desconecta el túnel actual y se vuelve a conectar con el nuevo servidor. Desconéctese antes de eliminar los servidores."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionar outro servidor desconecta o túnel atual e reconecta-se ao novo servidor. Desconecte antes de excluir os servidores."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي تحديد خادم آخر إلى قطع اتصال النفق الحالي وإعادة الاتصال بالخادم الجديد. قطع الاتصال قبل حذف الخوادم."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب سرور دیگری تونل فعلی را قطع می کند و دوباره با سرور جدید وصل می شود. قبل از حذف سرورها، اتصال را قطع کنید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir sunucunun seçilmesi mevcut tünelin bağlantısını keser ve yeni sunucuya yeniden bağlanır. Sunucuları silmeden önce bağlantıyı kesin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie einen anderen Server auswählen, wird der aktuelle Tunnel getrennt und die Verbindung mit dem neuen Server wiederhergestellt. Trennen Sie die Verbindung, bevor Sie Server löschen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择另一台服务器会断开当前隧道并重新连接新服务器。删除服务器之前先断开连接。"
          }
        }
      }
    },
    "Sends private and device-local address ranges directly instead of through the proxy.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie des plages d'adresses privées et locales de l'appareil directement au lieu de passer par le proxy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía rangos de direcciones privadas y locales del dispositivo directamente en lugar de a través del proxy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia intervalos de endereços privados e locais do dispositivo diretamente, em vez de através do proxy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل نطاقات العناوين الخاصة والمحلية للجهاز مباشرةً بدلاً من إرسالها عبر الوكيل."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به جای پراکسی، محدوده آدرس خصوصی و محلی دستگاه را مستقیماً ارسال می کند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel ve cihaz yerel adres aralıklarını proxy yerine doğrudan gönderir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet private und gerätelokale Adressbereiche direkt statt über den Proxy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接发送私有和设备本地地址范围，而不是通过代理。"
          }
        }
      }
    },
