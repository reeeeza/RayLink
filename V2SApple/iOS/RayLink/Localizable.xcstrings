    "DNS changes are applied on the next connection. System DNS leaves DNS selection to iOS.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications DNS sont appliquées à la connexion suivante. Le système DNS laisse la sélection DNS à iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de DNS se aplican en la próxima conexión. El DNS del sistema deja la selección de DNS para iOS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações de DNS são aplicadas na próxima conexão. O DNS do sistema deixa a seleção de DNS para o iOS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تطبيق تغييرات DNS على الاتصال التالي. نظام DNS يترك اختيار DNS لنظام iOS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات DNS در اتصال بعدی اعمال می شود. سیستم DNS انتخاب DNS را به iOS واگذار می کند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS değişiklikleri bir sonraki bağlantıda uygulanır. Sistem DNS, DNS seçimini iOS'a bırakır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-Änderungen werden bei der nächsten Verbindung übernommen. System-DNS überlässt die DNS-Auswahl iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS 更改将应用​​于下一次连接。系统 DNS 将 DNS 选择留给 iOS。"
          }
        }
      }
    },
