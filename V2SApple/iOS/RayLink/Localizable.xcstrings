    "Private subscription URLs are kept in Keychain and never shown in the list or app logs.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les URL des abonnements privés sont conservées dans le trousseau et ne sont jamais affichées dans la liste ou les journaux des applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las URL de suscripción privadas se guardan en Keychain y nunca se muestran en la lista ni en los registros de la aplicación."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os URLs de subscrição privados são mantidos no Keychain e nunca são mostrados na lista ou nos registos da aplicação."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ بعناوين URL الخاصة بالاشتراك في Keychain ولا تظهر أبدًا في القائمة أو سجلات التطبيق."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آدرس‌های اینترنتی اشتراک خصوصی در Keychain نگهداری می‌شوند و هرگز در فهرست یا گزارش‌های برنامه نشان داده نمی‌شوند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel abonelik URL'leri Anahtar Zincirinde tutulur ve hiçbir zaman listede veya uygulama günlüklerinde gösterilmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Abonnement-URLs werden im Schlüsselbund gespeichert und niemals in der Liste oder den App-Protokollen angezeigt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人订阅 URL 保存在钥匙串中，并且永远不会显示在列表或应用程序日志中。"
          }
        }
      }
    },
