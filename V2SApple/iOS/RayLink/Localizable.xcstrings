    "Keep only the resource files needed by routing rules to reduce local storage.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne conserver que les fichiers de ressources nécessaires aux règles de routage pour réduire le stockage local."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener solo los archivos de recursos necesarios mediante reglas de enrutamiento para reducir el almacenamiento local."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter apenas os arquivos de recursos necessários pelas regras de roteamento para reduzir o armazenamento local."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ فقط بملفات الموارد التي تحتاجها قواعد التوجيه لتقليل التخزين المحلي."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط فایل‌های منبع مورد نیاز قوانین مسیریابی را برای کاهش فضای ذخیره‌سازی محلی نگه دارید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel depolamayı azaltmak için yalnızca yönlendirme kurallarının ihtiyaç duyduğu kaynak dosyalarını saklayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie nur die Ressourcendateien bei, die von den Routing-Regeln benötigt werden, um den lokalen Speicher zu reduzieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留路由规则所需的资源文件，以减少本地存储。"
          }
        }
      }
    },
