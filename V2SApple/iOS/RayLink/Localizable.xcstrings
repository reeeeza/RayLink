    "Use + on the Connect screen to import an HTTPS subscription.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Use + sur l'écran Connect pour importer un abonnement HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice + en la pantalla Conectar para importar una suscripción HTTPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar + na tela Conectar para importar uma assinatura https."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم + على شاشة الاتصال لاستيراد اشتراك HTTPS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای وارد کردن اشتراک HTTPS از + در صفحه اتصال استفاده کنید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir HTTPS aboneliğini içe aktarmak için Bağlan ekranındaki + işaretini kullanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie + auf dem Bildschirm „Verbinden“, um ein HTTPS-Abonnement zu importieren."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“连接”屏幕上的 + 导入 HTTPS 订阅。"
          }
        }
      }
    },
