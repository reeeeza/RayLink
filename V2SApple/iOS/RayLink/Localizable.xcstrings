          }
        }
      }
    },
    "Import a server or subscription before testing latency.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un serveur ou un abonnement avant de tester la latence."
          }
        },
        "es": {
