    "Advanced Xray fragmentation. Defaults: tlshello, 100–200 bytes, 10–20 ms. Invalid values can prevent connection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmentation avancée des rayons X. Valeurs par défaut : tlshello, 100 à 200 octets, 10 à 20 ms. Des valeurs non valides peuvent empêcher la connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmentación avanzada de rayos X. Valores predeterminados: tlshello, 100–200 bytes, 10–20 ms. Los valores no válidos pueden impedir la conexión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragmentação avançada de raios X. Padrões: tlshello, 100–200 bytes, 10–20 ms. Valores inválidos podem impedir a conexão."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجزئة الأشعة السينية المتقدمة. الافتراضية: tlshello، 100-200 بايت، 10-20 مللي ثانية. قد تؤدي القيم غير الصالحة إلى منع الاتصال."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تکه تکه شدن پیشرفته اشعه ایکس. پیش فرض ها: tlshello، 100-200 بایت، 10-20 ms. مقادیر نامعتبر می توانند از اتصال جلوگیری کنند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş Xray parçalanması. Varsayılanlar: tlshello, 100–200 bayt, 10–20 ms. Geçersiz değerler bağlantıyı engelleyebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Röntgenfragmentierung. Standardeinstellungen: tlshello, 100–200 Bytes, 10–20 ms. Ungültige Werte können die Verbindung verhindern."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级 X 射线碎片。默认值：tlshello、100–200 字节、10–20 毫秒。无效值可能会阻止连接。"
          }
        }
      }
    },
