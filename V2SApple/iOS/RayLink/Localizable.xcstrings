    "V2S is free, private, and has no advertisements. Optional support can help fund testing and continued maintenance.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S est gratuit, privé et ne comporte aucune publicité. Une assistance facultative peut aider à financer les tests et la maintenance continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S es gratuito, privado y no tiene anuncios. El soporte opcional puede ayudar a financiar las pruebas y el mantenimiento continuo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O V2S é gratuito, privado e não tem anúncios. O suporte opcional pode ajudar a financiar testes e manutenção contínua."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S مجاني وخاص ولا يحتوي على إعلانات. يمكن أن يساعد الدعم الاختياري في تمويل الاختبار والصيانة المستمرة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S رایگان، خصوصی است و هیچ تبلیغی ندارد. پشتیبانی اختیاری می تواند به تست بودجه و نگهداری مداوم کمک کند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S ücretsizdir, özeldir ve reklam içermez. İsteğe bağlı destek, testlerin ve sürekli bakımın finansmanına yardımcı olabilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S ist kostenlos, privat und enthält keine Werbung. Durch optionalen Support können Tests und die weitere Wartung finanziert werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S是免费的、私密的、没有广告。可选支持可以帮助资助测试和持续维护。"
          }
        }
      }
    },
    "V2S keeps only credential-safe app events on this device.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S ne conserve que les événements d'application sécurisés par des informations d'identification sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S solo mantiene eventos de aplicaciones seguras para credenciales en este dispositivo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O V2S mantém apenas eventos de aplicativos seguros para credenciais neste dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ V2S فقط بأحداث التطبيق الآمنة لبيانات الاعتماد على هذا الجهاز."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S فقط رویدادهای برنامه ایمن اعتبارنامه را در این دستگاه نگه می دارد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S bu cihazda yalnızca kimlik bilgileri açısından güvenli uygulama olaylarını tutar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S speichert nur anmeldeinformationssichere App-Ereignisse auf diesem Gerät."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S 仅在此设备上保留凭据安全的应用程序事件。"
          }
        }
      }
    },
    "V2S verifies every resource before replacing the files currently in use.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S vérifie chaque ressource avant de remplacer les fichiers actuellement utilisés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S verifica todos los recursos antes de reemplazar los archivos actualmente en uso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O V2S verifica todos os recursos antes de substituir os arquivos atualmente em uso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق V2S من كل مورد قبل استبدال الملفات المستخدمة حاليًا."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S قبل از جایگزینی فایل‌هایی که در حال حاضر استفاده می‌شوند، هر منبع را تأیید می‌کند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S, halihazırda kullanımda olan dosyaları değiştirmeden önce her kaynağı doğrular."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S überprüft jede Ressource, bevor die aktuell verwendeten Dateien ersetzt werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S 在替换当前正在使用的文件之前会验证每个资源。"
          }
        }
      }
    },
