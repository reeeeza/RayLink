    "Open Connect and tap +.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Connexion et touchez +."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Conectar y toque +."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ligar e toque em +."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الاتصال واضغط على +."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال را باز کنید و روی + بزنید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlan ekranını açın ve + simgesine dokunun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Verbinden und tippen Sie auf +."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“连接”，然后点按 +。"
          }
        }
      }
    },
    "Paste a supported VLESS, VMess, Trojan, Shadowsocks, or HTTPS subscription link.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien VLESS, VMess, Trojan ou Shadowsocks pris en charge, ou un lien d’abonnement HTTPS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue un enlace compatible de VLESS, VMess, Trojan o Shadowsocks, o un enlace de suscripción HTTPS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um link compatível de VLESS, VMess, Trojan ou Shadowsocks, ou um link de subscrição HTTPS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألصق رابط VLESS أو VMess أو Trojan أو Shadowsocks مدعوماً، أو رابط اشتراك HTTPS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیوند پشتیبانی‌شدهٔ VLESS، VMess، Trojan یا Shadowsocks یا پیوند اشتراک HTTPS را جای‌گذاری کنید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen bir VLESS, VMess, Trojan veya Shadowsocks bağlantısı ya da HTTPS abonelik bağlantısı yapıştırın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen unterstützten VLESS-, VMess-, Trojan- oder Shadowsocks-Link oder einen HTTPS-Abonnementlink ein."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴受支持的 VLESS、VMess、Trojan、Shadowsocks 链接或 HTTPS 订阅链接。"
          }
        }
      }
    },
    "Choose a saved server. Never share its private link or credentials.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un serveur enregistré. Ne partagez jamais son lien privé ni ses identifiants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un servidor guardado. Nunca comparta su enlace privado ni sus credenciales."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um servidor guardado. Nunca partilhe o respetivo link privado nem as credenciais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خادماً محفوظاً. لا تشارك رابطه الخاص أو بيانات اعتماده أبداً."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک سرور ذخیره‌شده را انتخاب کنید. پیوند خصوصی یا اطلاعات ورود آن را هرگز به اشتراک نگذارید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmiş bir sunucu seçin. Özel bağlantısını veya kimlik bilgilerini asla paylaşmayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen gespeicherten Server. Geben Sie dessen privaten Link oder Zugangsdaten niemals weiter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已保存的服务器。切勿分享其私人链接或凭据。"
          }
        }
      }
    },
    "Tap the power button and allow iOS to add the VPN configuration if asked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton d’alimentation et autorisez iOS à ajouter la configuration VPN si demandé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el botón de encendido y permita que iOS añada la configuración VPN si se le solicita."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão de ligar e permita que o iOS adicione a configuração VPN, se solicitado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر التشغيل واسمح لـ iOS بإضافة إعداد VPN إذا طُلب منك ذلك."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی دکمهٔ روشن/خاموش بزنید و اگر iOS درخواست کرد، اجازهٔ افزودن پیکربندی VPN را بدهید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güç düğmesine dokunun ve istenirse iOS’un VPN yapılandırmasını eklemesine izin verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Einschalttaste und erlauben Sie iOS auf Nachfrage, die VPN-Konfiguration hinzuzufügen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按电源按钮；如有提示，允许 iOS 添加 VPN 配置。"
          }
        }
      }
    },
    "V2S has no advertising or analytics SDK. The VPN tunnel processes traffic and DNS needed for your connection. The selected server operator may see your connecting IP and connection metadata.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S ne contient aucun SDK publicitaire ou d’analyse. Le tunnel VPN traite le trafic et le DNS nécessaires à votre connexion. L’exploitant du serveur choisi peut voir votre adresse IP de connexion et les métadonnées de connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S no incluye SDK de publicidad ni de análisis. El túnel VPN procesa el tráfico y el DNS necesarios para su conexión. El operador del servidor elegido puede ver su IP de conexión y los metadatos de la conexión."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O V2S não inclui SDK de publicidade ou análise. O túnel VPN processa o tráfego e o DNS necessários para a ligação. O operador do servidor escolhido pode ver o seu IP e os metadados da ligação."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي V2S على أدوات تطوير للإعلانات أو التحليلات. يعالج نفق VPN حركة البيانات وطلبات DNS اللازمة لاتصالك. قد يرى مشغّل الخادم المختار عنوان IP الخاص باتصالك وبيانات الاتصال الوصفية."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S کیت تبلیغات یا تحلیل ندارد. تونل VPN ترافیک و DNS لازم برای اتصال شما را پردازش می‌کند. اداره‌کنندهٔ سرور انتخابی ممکن است IP اتصال و فرادادهٔ اتصال شما را ببیند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S reklam veya analiz SDK’sı içermez. VPN tüneli, bağlantınız için gereken trafiği ve DNS sorgularını işler. Seçtiğiniz sunucunun işletmecisi bağlantı IP adresinizi ve bağlantı meta verilerini görebilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S enthält keine Werbe- oder Analyse-SDKs. Der VPN-Tunnel verarbeitet den für Ihre Verbindung erforderlichen Datenverkehr und DNS-Anfragen. Der Betreiber des gewählten Servers kann Ihre Verbindungs-IP und Verbindungsmetadaten sehen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "V2S 不含广告或分析 SDK。VPN 隧道处理连接所需的流量和 DNS。所选服务器的运营者可能看到您的连接 IP 地址和连接元数据。"
          }
        }
      }
    },
    "Imported proxy configurations are stored in the app’s private App Group on this device and are read to create the VPN connection. Never share screenshots that reveal configuration links or credentials.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les configurations proxy importées sont conservées dans le groupe d’apps privé de l’application sur cet appareil et lues pour établir la connexion VPN. Ne partagez jamais de captures montrant des liens de configuration ou des identifiants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las configuraciones de proxy importadas se guardan en el grupo privado de apps de este dispositivo y se leen para crear la conexión VPN. Nunca comparta capturas que revelen enlaces de configuración o credenciales."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de proxy importadas são guardadas no grupo privado da aplicação neste dispositivo e lidas para criar a ligação VPN. Nunca partilhe capturas que revelem links de configuração ou credenciais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزَّن إعدادات البروكسي المستوردة في مجموعة التطبيقات الخاصة بهذا التطبيق على الجهاز، وتُقرأ لإنشاء اتصال VPN. لا تشارك لقطات شاشة تكشف روابط الإعداد أو بيانات الاعتماد."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکربندی‌های پروکسی واردشده در App Group خصوصی برنامه روی این دستگاه نگهداری و برای ایجاد اتصال VPN خوانده می‌شوند. هرگز تصویری که پیوند پیکربندی یا اطلاعات ورود را نشان می‌دهد به اشتراک نگذارید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarılan proxy yapılandırmaları bu cihazdaki uygulamanın özel App Group alanında saklanır ve VPN bağlantısını oluşturmak için okunur. Yapılandırma bağlantılarını veya kimlik bilgilerini gösteren ekran görüntülerini asla paylaşmayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Proxy-Konfigurationen werden in der privaten App Group der App auf diesem Gerät gespeichert und zum Aufbau der VPN-Verbindung gelesen. Teilen Sie niemals Screenshots, die Konfigurationslinks oder Zugangsdaten zeigen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的代理配置存储在此设备上本应用的专用 App Group 中，并用于建立 VPN 连接。切勿分享泄露配置链接或凭据的屏幕截图。"
          }
        }
      }
    },
    "When you import a subscription, V2S contacts that provider directly. The private URL is stored in the iOS Keychain so you can refresh it later. Imported server profiles are stored in the private App Group and can include connection credentials. The provider may see your request and has its own privacy practices.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous importez un abonnement, V2S contacte directement ce fournisseur. Son URL privée est conservée dans le trousseau iOS pour les mises à jour futures. Les profils de serveur importés sont stockés dans le groupe d’apps privé et peuvent contenir des identifiants de connexion. Le fournisseur peut voir votre demande et applique ses propres pratiques de confidentialité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al importar una suscripción, V2S contacta directamente con ese proveedor. La URL privada se guarda en el llavero de iOS para poder actualizarla después. Los perfiles de servidor importados se guardan en el grupo privado de apps y pueden incluir credenciales de conexión. El proveedor puede ver su solicitud y aplica sus propias prácticas de privacidad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao importar uma subscrição, o V2S contacta diretamente esse fornecedor. O URL privado é guardado no Porta-chaves do iOS para futuras atualizações. Os perfis de servidor importados são guardados no grupo privado da aplicação e podem incluir credenciais de ligação. O fornecedor pode ver o pedido e tem as suas próprias práticas de privacidade."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند استيراد اشتراك، يتصل V2S بذلك المزوّد مباشرةً. يُحفظ الرابط الخاص في سلسلة مفاتيح iOS لتحديثه لاحقاً. تُخزَّن ملفات الخوادم المستوردة في مجموعة التطبيقات الخاصة وقد تتضمن بيانات اعتماد الاتصال. قد يرى المزوّد طلبك وله ممارسات الخصوصية الخاصة به."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی اشتراکی را وارد می‌کنید، V2S مستقیماً با ارائه‌دهندهٔ آن تماس می‌گیرد. نشانی خصوصی در Keychain سیستم iOS ذخیره می‌شود تا بعداً بتوانید آن را به‌روزرسانی کنید. پروفایل‌های سرور واردشده در App Group خصوصی ذخیره می‌شوند و ممکن است اطلاعات ورود اتصال را داشته باشند. ارائه‌دهنده ممکن است درخواست شما را ببیند و رویهٔ حریم خصوصی خود را دارد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir aboneliği içe aktardığınızda V2S sağlayıcıya doğrudan bağlanır. Özel URL, daha sonra yenileyebilmeniz için iOS Anahtar Zinciri’nde saklanır. İçe aktarılan sunucu profilleri özel App Group alanında saklanır ve bağlantı kimlik bilgileri içerebilir. Sağlayıcı isteğinizi görebilir ve kendi gizlilik uygulamalarına sahiptir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Import eines Abonnements kontaktiert V2S den Anbieter direkt. Die private URL wird im iOS-Schlüsselbund gespeichert, damit Sie sie später aktualisieren können. Importierte Serverprofile werden in der privaten App Group gespeichert und können Zugangsdaten enthalten. Der Anbieter kann Ihre Anfrage sehen und hat eigene Datenschutzpraktiken."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入订阅时，V2S 会直接联系该提供者。私人 URL 存储在 iOS 钥匙串中，以便稍后刷新。导入的服务器配置存储在专用 App Group 中，可能包含连接凭据。提供者可能看到您的请求，并有自己的隐私做法。"
          }
        }
      }
    },
    "You may use a server you add or a V2S-operated Premium server. Independent operators control their own service and privacy practices. Optional free-server scans contact the V2S catalog for worker-checked public servers. Availability changes; an endpoint check does not establish privacy or a working VPN tunnel.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez utiliser un serveur ajouté par vous ou un serveur Premium exploité par V2S. Les opérateurs indépendants contrôlent leur service et leurs pratiques de confidentialité. Le scan facultatif des serveurs gratuits contacte le catalogue V2S pour trouver des serveurs publics vérifiés. La disponibilité varie ; un contrôle de point d’accès ne garantit ni la confidentialité ni le fonctionnement du tunnel VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede usar un servidor añadido por usted o un servidor Premium operado por V2S. Los operadores independientes controlan su servicio y sus prácticas de privacidad. El análisis opcional de servidores gratuitos consulta el catálogo de V2S para buscar servidores públicos comprobados. La disponibilidad cambia; comprobar un punto de acceso no garantiza privacidad ni un túnel VPN funcional."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode usar um servidor adicionado por si ou um servidor Premium operado pelo V2S. Os operadores independentes controlam o respetivo serviço e práticas de privacidade. A pesquisa opcional de servidores gratuitos consulta o catálogo V2S para encontrar servidores públicos verificados. A disponibilidade varia; testar um endpoint não garante privacidade nem um túnel VPN funcional."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك استخدام خادم تضيفه بنفسك أو خادم Premium يشغّله V2S. يتحكم المشغّلون المستقلون في خدماتهم وممارسات الخصوصية لديهم. يتصل الفحص الاختياري للخوادم المجانية بفهرس V2S للعثور على خوادم عامة جرى التحقق منها. قد يتغير التوفر؛ وفحص نقطة الاتصال لا يثبت الخصوصية أو عمل نفق VPN."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانید از سروری که خودتان افزوده‌اید یا سرور Premium اداره‌شده توسط V2S استفاده کنید. گردانندگان مستقل بر خدمات و رویه‌های حریم خصوصی خود کنترل دارند. پویش اختیاری سرورهای رایگان برای یافتن سرورهای عمومی بررسی‌شده به فهرست V2S متصل می‌شود. دسترس‌پذیری تغییر می‌کند؛ بررسی نقطهٔ پایانی، حریم خصوصی یا کارکرد تونل VPN را تضمین نمی‌کند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklediğiniz bir sunucuyu veya V2S tarafından işletilen bir Premium sunucuyu kullanabilirsiniz. Bağımsız işletmeciler kendi hizmetlerini ve gizlilik uygulamalarını yönetir. İsteğe bağlı ücretsiz sunucu taraması, denetlenmiş genel sunucular için V2S kataloğuna bağlanır. Kullanılabilirlik değişebilir; uç nokta denetimi gizliliği veya çalışan bir VPN tünelini garanti etmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können einen selbst hinzugefügten Server oder einen von V2S betriebenen Premium-Server nutzen. Unabhängige Betreiber bestimmen ihren Dienst und ihre Datenschutzpraktiken selbst. Die optionale Suche nach kostenlosen Servern kontaktiert den V2S-Katalog für geprüfte öffentliche Server. Die Verfügbarkeit ändert sich; ein Endpunkt-Test belegt weder Datenschutz noch einen funktionierenden VPN-Tunnel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以使用自己添加的服务器或 V2S 运营的 Premium 服务器。独立运营者自行管理其服务和隐私做法。可选的免费服务器扫描会联系 V2S 目录，查找经过检查的公共服务器。可用性会变化；端点检查不能证明隐私性，也不能证明 VPN 隧道可用。"
          }
        }
      }
    },
    "Apple processes purchases. V2S sends an Apple-signed transaction to its verification service to activate and restore Premium access. The service maintains entitlement and operational account records. V2S does not receive your payment card details.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple traite les achats. V2S transmet une transaction signée par Apple à son service de vérification pour activer et restaurer l’accès Premium. Ce service conserve les droits d’accès et les données opérationnelles du compte. V2S ne reçoit pas les données de votre carte de paiement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple procesa las compras. V2S envía una transacción firmada por Apple a su servicio de verificación para activar y restaurar el acceso Premium. El servicio conserva los derechos de acceso y los registros operativos de la cuenta. V2S no recibe los datos de su tarjeta de pago."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple processa as compras. O V2S envia uma transação assinada pela Apple ao serviço de verificação para ativar e restaurar o acesso Premium. O serviço mantém os direitos de acesso e os registos operacionais da conta. O V2S não recebe os dados do seu cartão de pagamento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعالج Apple عمليات الشراء. يرسل V2S معاملة موقّعة من Apple إلى خدمة التحقق لتفعيل وصول Premium واستعادته. تحتفظ الخدمة بسجلات الاستحقاق والحساب التشغيلية. لا يتلقى V2S بيانات بطاقة الدفع الخاصة بك."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پردازش خریدها با Apple است. V2S تراکنش امضاشدهٔ Apple را برای فعال‌سازی و بازیابی دسترسی Premium به سرویس تأیید خود می‌فرستد. این سرویس سوابق حق دسترسی و حساب عملیاتی را نگه می‌دارد. V2S اطلاعات کارت پرداخت شما را دریافت نمی‌کند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma işlemlerini Apple yürütür. V2S, Premium erişimini etkinleştirmek ve geri yüklemek için Apple imzalı işlemi doğrulama hizmetine gönderir. Hizmet, erişim hakkı ve işletimsel hesap kayıtlarını tutar. V2S ödeme kartı bilgilerinizi almaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple verarbeitet Käufe. V2S sendet eine von Apple signierte Transaktion an seinen Prüfdienst, um den Premium-Zugang zu aktivieren oder wiederherzustellen. Der Dienst führt Berechtigungs- und betriebliche Kontodatensätze. V2S erhält keine Angaben zu Ihrer Zahlungskarte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买由 Apple 处理。V2S 将 Apple 签名的交易发送至验证服务，以激活和恢复 Premium 访问权限。该服务保存权益和账户运行记录。V2S 不会收到您的支付卡信息。"
          }
        }
      }
    },
