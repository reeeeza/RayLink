    "Routing changes take effect the next time the tunnel connects.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de routage prennent effet la prochaine fois que le tunnel se connecte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de enrutamiento entrarán en vigor la próxima vez que se conecte el túnel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações de roteamento entram em vigor na próxima vez que o túnel se conectar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسري تغييرات التوجيه في المرة التالية التي يتصل فيها النفق."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تغییرات مسیریابی دفعه بعد که تونل متصل می شود اعمال می شود."
          }
        },
        "tr": {
          "stringUnit": {
