    "Multiplexes compatible connections through fewer proxy connections. Reconnect to apply.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplexe les connexions compatibles grâce à moins de connexions proxy. Reconnectez-vous pour postuler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplexar conexiones compatibles a través de menos conexiones proxy. Vuelve a conectarte para aplicar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexões compatíveis com multiplexação através de menos conexões de proxy. Reconecte-se para aplicar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعدد الاتصالات المتوافقة من خلال عدد أقل من اتصالات الوكيل. أعد الاتصال للتقديم."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصالات سازگار را از طریق اتصالات پراکسی کمتر چندپلکس می کند. برای اعمال مجدد وصل شوید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az sayıda proxy bağlantısı aracılığıyla uyumlu bağlantıları çoğaltır. Başvurmak için yeniden bağlanın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplext kompatible Verbindungen durch weniger Proxy-Verbindungen. Stellen Sie die Verbindung erneut her, um sich zu bewerben."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过更少的代理连接来复用兼容连接。重新连接即可申请。"
          }
        }
      }
    },
