    "Independent public servers. Scanning contacts the V2S catalog; Ping checks endpoint reachability, not a complete VPN connection.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveurs publics indépendants. La numérisation contacte le catalogue V2S ; Ping vérifie l'accessibilité du point de terminaison, pas une connexion VPN complète."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores públicos independientes. El escaneo contacta con el catálogo de V2S; Ping comprueba la accesibilidad del punto final, no una conexión VPN completa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores públicos independentes. A digitalização entra em contacto com o catálogo V2S; O ping verifica a acessibilidade do ponto de extremidade, não uma ligação VPN completa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خوادم عامة مستقلة. مسح جهات الاتصال في كتالوج V2S؛ يتحقق Ping من إمكانية الوصول إلى نقطة النهاية، وليس اتصال VPN كاملاً."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرورهای عمومی مستقل اسکن مخاطبین کاتالوگ V2S. پینگ دسترسی به نقطه پایانی را بررسی می کند، نه یک اتصال VPN کامل."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız genel sunucular. Tarama, V2S kataloğundaki kişileri; Ping, tam bir VPN bağlantısını değil, uç noktanın erişilebilirliğini kontrol eder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unabhängige öffentliche Server. Scannen von Kontakten zum V2S-Katalog; Ping prüft die Erreichbarkeit des Endpunkts, nicht eine vollständige VPN-Verbindung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立的公共服务器。扫描联系人V2S目录； Ping 检查端点的可达性，而不是完整的 VPN 连接。"
          }
        }
      }
    },
