    "One Xray domain matcher per line, for example domain:example.com or regexp:.*\\\\.example\\\\.com$.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un matcher de domaine Xray par ligne, par exemple domaine :example.com ou regexp :.*\\\\.exemple\\\\.com$ ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un emparejador de dominios Xray por línea, por ejemplo, domain:example.com o regexp:.*\\\\.example\\\\.com$."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um correspondente de domínio Xray por linha, por exemplo domínio:example.com ou regexp:.*\\\\.example\\\\.com$."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُطابق نطاق Xray واحد لكل سطر، على سبيل المثال domain:example.com أو regexp:.*\\\\.example\\\\.com$."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک تطبیق دامنه Xray در هر خط، برای مثال domain:example.com یا regexp:.*\\\\.example\\\\.com$."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satıra bir Xray alan adı eşleştirici, örneğin alan adı:example.com veya regexp:.*\\\\.example\\\\.com$."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Xray-Domänen-Matcher pro Zeile, zum Beispiel domain:example.com oder regexp:.*\\\\.example\\\\.com$."
