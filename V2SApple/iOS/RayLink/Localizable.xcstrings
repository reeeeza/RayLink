  "strings": {
    "Redeem offer code": {
      "localizations": { "fa": { "stringUnit": { "state": "translated", "value": "وارد کردن کد پیشنهاد اشتراک" } } }
    },
    "Redeem a V2S Premium Monthly or Yearly subscription offer code. Apple shows the free or discounted period and renewal terms before confirmation. App-download promo codes do not include Premium.": {
      "localizations": { "fa": { "stringUnit": { "state": "translated", "value": "کد پیشنهاد اشتراک ماهانه یا سالانه V2S Premium را وارد کنید. اپل مدت رایگان یا تخفیف و شرایط تمدید را پیش از تأیید نمایش می‌دهد. کد دانلود برنامه شامل اشتراک Premium نیست." } } }
    },
