    "Not recommended. HTTPS protects subscription credentials while they travel to the provider.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non recommandé. HTTPS protège les informations d'identification de l'abonnement lorsqu'ils se rendent chez le fournisseur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recomendado. HTTPS protege las credenciales de suscripción mientras viajan al proveedor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não recomendado. O HTTPS protege as credenciais de assinatura enquanto elas viajam para o provedor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مستحسن. يحمي HTTPS بيانات اعتماد الاشتراك أثناء انتقالها إلى الموفر."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توصیه نمی شود. HTTPS از اعتبارنامه های اشتراک در حین سفر به ارائه دهنده محافظت می کند."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavsiye edilmez. HTTPS, abonelik kimlik bilgilerini sağlayıcıya giderken korur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht empfohlen. HTTPS schützt Abonnement-Anmeldeinformationen, während sie zum Anbieter übertragen werden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不推荐。 HTTPS 可在订阅凭据传输到提供商时对其进行保护。"
          }
        }
      }
    },
