    "Choose a community preset or create your own.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir un préréglage de communauté ou créer le vôtre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un ajuste preestablecido de la comunidad o crea el tuyo propio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma predefinição de comunidade ou crie a sua própria."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر إعدادًا مسبقًا للمجتمع أو أنشئ إعدادًا خاصًا بك."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک انجمن از پیش تنظیم شده را انتخاب کنید یا خود را ایجاد کنید."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir topluluk ön ayarı seçin veya kendinizinkini oluşturun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Community-Voreinstellung oder erstellen Sie Ihre eigene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择社区预设或创建您自己的预设。"
          }
        }
      }
    },
    "Choose a location after your subscription is active. Your own servers remain free to use.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un emplacement une fois votre abonnement actif. Vos propres serveurs restent libres d'utilisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una ubicación después de que tu suscripción esté activa. Sus propios servidores siguen siendo de uso gratuito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um local após a sua subscrição estar ativa. Os seus próprios servidores permanecem livres para usar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر موقعًا بعد تفعيل اشتراكك. تظل الخوادم الخاصة بك مجانية للاستخدام."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از فعال شدن اشتراک، مکانی را انتخاب کنید. استفاده از سرورهای خودتان آزاد است."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneliğiniz aktif hale geldikten sonra bir konum seçin. Kendi sunucularınızın kullanımı ücretsiz kalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Standort, nachdem Ihr Abonnement aktiv ist. Die Nutzung Ihrer eigenen Server bleibt weiterhin kostenlos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅生效后选择一个位置。您自己的服务器仍然可以免费使用。"
          }
        }
      }
    },
