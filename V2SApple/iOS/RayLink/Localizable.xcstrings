    "Import a server link or HTTPS subscription to begin.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer un lien serveur ou un abonnement HTTPS pour commencer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar un enlace de servidor o suscripción HTTPS para comenzar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a server link or HTTPS subscription to begin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم باستيراد رابط الخادم أو اشتراك HTTPS للبدء."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای شروع، پیوند سرور یا اشتراک HTTPS را وارد کنید."
          }
        },
        "tr": {
          "stringUnit": {
